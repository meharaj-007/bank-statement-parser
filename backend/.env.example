# Groq API (required) - https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Any Groq model that accepts images
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MAX_TOKENS=8192
GROQ_REQUEST_TIMEOUT=120
GROQ_MAX_RETRIES=3
# Pages sent to Groq in parallel per statement; lower this if you hit rate limits
PAGE_CONCURRENCY=3

# Celery broker
CELERY_BROKER_URL=redis://localhost:6379/0
# Hard time limit per statement, seconds
TASK_TIME_LIMIT=1800

# Server
ENVIRONMENT=development
DEBUG=False
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (run `alembic upgrade head` after changing)
DATABASE_URL=sqlite:///./database.db

# Storage
UPLOAD_DIR=./uploads
PAGE_IMAGES_DIR=./page_images
CLEANUP_TEMP_FILES=True
MAX_UPLOAD_SIZE=52428800
MAX_PAGES=100

# PDF rendering. Groq caps images at 4MB base64, pages are shrunk to fit MAX_IMAGE_BYTES
PDF_DPI=200
JPEG_QUALITY=85
MAX_IMAGE_BYTES=3145728

# Account numbers are stored masked (XXXXXX1234) unless disabled
MASK_PII=True
PII_MASK_CHAR=X
PII_SHOW_LAST=4

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
